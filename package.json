{
  "name": "cumsa-t3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,json,css}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,json,css}\" --cache",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-navigation-menu": "1.2.18",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4",
    "tailwind-merge": "3.6.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.0.15",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.5",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "postcss": "8.5.17",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "4.0.15",
    "tw-animate-css": "1.3.6",
    "typescript": "5.8.2",
    "typescript-eslint": "8.63.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{css,html}": [
      "prettier --write"
    ]
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "npm@12.1.0",
  "allowScripts": {
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
